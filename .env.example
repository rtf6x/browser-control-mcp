# Browser Control MCP — optional server settings
#
# Default: no .env needed. Run: npm run docker:up
#
# Optional hardening — require HMAC on WebSocket messages
# (extensions must have matching secret in storage from an older install,
#  or set EXTENSION_SECRET on server only if you add signing back manually)
# EXTENSION_SECRET=
#
# Optional — override ports inside the container
# EXTENSION_PORT=18789
# MCP_HTTP_PORT=18790
