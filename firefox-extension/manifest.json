{
    "manifest_version": 2,
    "name": "Browser Control MCP (Personal)",
    "version": "1.5.2",
    "description": "Personal fork: local MCP server control for Firefox (tabs, history, page tools). Not affiliated with the AMO add-on.",
    "browser_specific_settings": {
        "gecko": {
            "id": "browser-control-mcp-personal@rtf6x.local",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "permissions": [
        "tabs",
        "tabGroups",
        "history",
        "storage"
    ],
    "optional_permissions": [
        "*://*/*",
        "find"
    ],
    "background": {
      "scripts": ["dist/background.js"]
    },
    "options_ui": {
      "page": "options.html"
    }
  }
